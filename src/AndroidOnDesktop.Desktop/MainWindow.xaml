<Window x:Class="AndroidOnDesktop.Desktop.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Android 窗口" Width="1180" Height="800" MinWidth="960" MinHeight="640"
 WindowStartupLocation="CenterScreen" AllowDrop="True" Drop="Window_Drop"
 Closing="Window_Closing" ContentRendered="Window_ContentRendered">
 <Grid Margin="28,22">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,22">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBlock Text="Android 窗口" FontSize="28" FontWeight="SemiBold" VerticalAlignment="Center"/>
   <StackPanel Grid.Column="1" Orientation="Horizontal">
    <Button Content="安装运行组件" Click="Setup_Click"/>
    <Button Content="运行配置" Click="ToggleSettings_Click"/>
    <Button Content="打开日志" Click="OpenLogs_Click" Margin="0"/>
   </StackPanel>
  </Grid>
  <Border Grid.Row="1" Background="White" CornerRadius="10" Padding="18" Margin="0,0,0,18">
   <StackPanel>
    <DockPanel LastChildFill="False" x:Name="RuntimeActions">
     <Button Content="启动 Android" Style="{StaticResource PrimaryButton}" Click="Start_Click"/>
     <Button x:Name="StopAndroidButton" Content="停止 Android" Click="Stop_Click" IsEnabled="False" ToolTip="停止本程序管理的安卓环境并释放内存；关闭主程序时也会执行。"/>
     <Button Content="检测环境" Click="Detect_Click"/>
     <Button Content="刷新设备" Click="Devices_Click"/>
     <ComboBox x:Name="DevicesBox" Width="270" DisplayMemberPath="Serial" SelectionChanged="Devices_SelectionChanged"/>
    </DockPanel>
    <Grid Margin="0,14,0,0">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <TextBlock x:Name="OperationText" Text="先安装运行组件，再启动 Android。" VerticalAlignment="Center" TextWrapping="Wrap"/>
     <Button x:Name="CancelButton" Grid.Column="1" Content="取消操作" Click="Cancel_Click" Visibility="Collapsed" Margin="12,0,0,0"/>
    </Grid>
    <ProgressBar x:Name="BusyProgress" Height="3" Margin="0,12,0,0" IsIndeterminate="True" Visibility="Collapsed" Foreground="{StaticResource Accent}"/>
   </StackPanel>
  </Border>
  <Border x:Name="ErrorBanner" Grid.Row="2" Background="#FFF1EF" BorderBrush="#DE8A7E" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,0,18" Visibility="Collapsed">
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBlock x:Name="ErrorText" FontSize="14" Foreground="#8C2417" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center"/>
    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center">
     <Button Content="查看日志" Click="OpenLogs_Click"/>
     <Button Content="关闭提示" Click="DismissError_Click" Margin="0"/>
    </StackPanel>
   </Grid>
  </Border>
  <Grid Grid.Row="3">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <Border Background="White" CornerRadius="10" Padding="20">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <DockPanel x:Name="AppActions" LastChildFill="False" Margin="0,0,0,16">
      <TextBlock Text="我的应用" FontSize="20" FontWeight="SemiBold" Margin="0,0,24,0" VerticalAlignment="Center"/>
      <Button Content="安装 APK" Style="{StaticResource PrimaryButton}" Click="Install_Click"/>
      <Button Content="刷新应用" Click="RefreshApps_Click"/>
     </DockPanel>
     <TextBox x:Name="SearchBox" Grid.Row="1" TextChanged="Search_TextChanged" Margin="0,0,0,12" ToolTip="按应用包名筛选" AutomationProperties.Name="按应用包名筛选"/>
     <Grid Grid.Row="2">
      <ListBox x:Name="AppsList" BorderBrush="#E1E6EB" MouseDoubleClick="Apps_DoubleClick" ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
       <ListBox.ItemTemplate><DataTemplate>
        <Border Padding="12,14" BorderBrush="#E9EEF1" BorderThickness="0,0,0,1">
         <TextBlock Text="{Binding PackageName}" FontSize="16" TextTrimming="CharacterEllipsis"/>
        </Border>
       </DataTemplate></ListBox.ItemTemplate>
      </ListBox>
      <TextBlock x:Name="EmptyText" Text="安装 APK 后，应用会显示在这里。&#x0a;也可以将 APK 拖入此窗口。" TextAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="16" IsHitTestVisible="False"/>
     </Grid>
     <DockPanel Grid.Row="3" x:Name="LaunchActions" LastChildFill="False" Margin="0,16,0,0">
      <Button Content="打开应用窗口" Style="{StaticResource PrimaryButton}" Click="Launch_Click"/>
      <Button Content="打开 Android 设置" Click="AndroidSettings_Click" Margin="0"/>
     </DockPanel>
    </Grid>
   </Border>
   <Border x:Name="SettingsPanel" Grid.Column="1" Width="368" Margin="18,0,0,0" Background="White" CornerRadius="10" Padding="20" Visibility="Collapsed">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
     <StackPanel x:Name="SettingsFields">
      <TextBlock Text="运行配置" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,18"/>
      <TextBlock Text="ADB 路径" Margin="0,0,0,6"/><TextBox x:Name="AdbPathBox"/>
      <TextBlock Text="Emulator 路径" Margin="0,12,0,6"/><TextBox x:Name="EmulatorPathBox"/>
      <TextBlock Text="scrcpy 路径" Margin="0,12,0,6"/><TextBox x:Name="ScrcpyPathBox"/>
      <TextBlock Text="Android 虚拟设备（AVD）" Margin="0,12,0,6"/><ComboBox x:Name="AvdBox" IsEditable="True"/>
      <TextBlock Text="设备序列号" Margin="0,12,0,6"/><TextBox x:Name="SerialBox"/>
      <TextBlock Text="窗口分辨率" Margin="0,12,0,6"/><TextBox x:Name="SizeBox"/>
      <TextBlock Text="图形加速" FontSize="14" Margin="0,12,0,6"/>
      <ComboBox x:Name="GpuModeBox" SelectedValuePath="Tag" FontSize="14" ToolTip="重启 Android 后生效。">
       <ComboBoxItem Content="自动兼容" Tag="auto"/>
       <ComboBoxItem Content="显卡硬件加速" Tag="host"/>
      </ComboBox>
      <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
       <StackPanel Margin="0,0,10,0"><TextBlock Text="安卓内存（MB）" FontSize="14" Margin="0,0,0,6"/><TextBox x:Name="MemoryBox" FontSize="14" ToolTip="重启 Android 后生效。"/></StackPanel>
       <StackPanel Grid.Column="1"><TextBlock Text="帧率上限" FontSize="14" Margin="0,0,0,6"/><TextBox x:Name="FrameRateBox" FontSize="14" ToolTip="新打开的应用窗口生效。"/></StackPanel>
      </Grid>
      <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
       <StackPanel Margin="0,0,10,0"><TextBlock Text="显示 DPI" Margin="0,0,0,6"/><TextBox x:Name="DpiBox"/></StackPanel>
       <StackPanel Grid.Column="1"><TextBlock Text="模拟器端口" Margin="0,0,0,6"/><TextBox x:Name="PortBox"/></StackPanel>
      </Grid>
      <WrapPanel Margin="0,18,0,0"><Button Content="保存配置" Click="Save_Click"/><Button Content="自动查找" Click="Locate_Click" Margin="0"/></WrapPanel>
     </StackPanel>
    </ScrollViewer>
   </Border>
  </Grid>
  <Expander Grid.Row="4" Header="运行日志" Margin="0,18,0,0">
   <TextBox x:Name="LogBox" Height="150" IsReadOnly="True" FontFamily="Consolas, Microsoft YaHei UI" FontSize="14" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0"/>
  </Expander>
 </Grid>
</Window>
